{
  "name": "authenticator-2fa",
  "private": true,
  "version": "0.0.24",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "bash build.sh",
    "build:check": "pnpm run check && pnpm run test && pnpm run build",
    "build:prod": "bash build.sh production",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "store:screenshots": "pnpm run build && node scripts/generate-store-screenshots.mjs",
    "lint": "oxlint --type-aware src test scripts vite.config.ts",
    "check": "pnpm run lint && pnpm run test:types && tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.test.json",
    "clean": "node scripts/clean.mjs",
    "package": "pnpm run clean && pnpm run build:prod && node scripts/package-extension.mjs",
    "format": "prettier --write src/app src/features src/shared src/lib/state src/lib/auth/passkey.ts test/state/react*.tsx",
    "build:verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "daisyui": "^5.7.50",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
